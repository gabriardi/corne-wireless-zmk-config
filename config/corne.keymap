#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        // Macros for the arrow operators
        fat_arrow: fat_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };
        thin_arrow: thin_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <36 37 38 39 40 41 6 7 8 9 10 18 19 20 21 22 30 31 32 33 34 11 23>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <39 40 41 36 37 38 1 2 3 4 5 13 14 15 16 17 25 26 27 28 29 36 37>;
            hold-trigger-on-release;
            flavor = "balanced";
        };
    };

    combos {
        compatible = "zmk,combos";

        // NEW: Safe Combo for "=>" (Top Row Right)
        combo_fat_arrow {
            timeout-ms = <40>;
            key-positions = <7 8>; // U and I
            bindings = <&fat_arrow>;
            layers = <0>;
        };

        // Cmd + Shift + R (Refactor / Reload)
        // Trigger: T + G (Left Index Barre Chord)
        reload_refactor {
            timeout-ms = <50>;
            key-positions = <5 17>; // T and G
            bindings = <&kp LS(LG(R))>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q        &kp W        &kp E         &kp R          &kp T         &kp Y        &kp U         &kp I         &kp O        &kp P           &kp BSPC
&kp ESC    &hml LCTRL A &hml LALT S  &hml LGUI D   &hml LSHIFT F  &kp G         &kp H        &hmr RSHIFT J &hmr RGUI K   &hmr RALT L  &hmr RCTRL SEMI &kp SQT
&kp LSHFT  &kp Z        &kp X        &kp C         &kp V          &kp B         &kp N        &kp M         &kp COMMA     &kp DOT      &kp FSLH        &kp RET
                                     &mo 2         &mo 1          &kp SPACE     &kp RET      &mo 3         &mo 4
            >;
        };

        // NUM: Left Hand = Modifiers | Right Hand = Numpad
        Num {
            display-name = "Num";
            bindings = <
&trans     &trans       &trans       &trans        &trans         &trans        &kp SLASH    &kp N7        &kp N8        &kp N9       &kp MINUS       &kp BSPC
&trans     &kp LCTRL    &kp LALT     &kp LGUI      &kp LSHIFT     &trans        &kp ASTERISK &kp N4        &kp N5        &kp N6       &kp PLUS        &kp EQUAL
&trans     &kp LG(Z)    &kp LG(X)    &kp LG(C)     &kp LG(V)      &trans        &kp N0       &kp N1        &kp N2        &kp N3       &kp DOT         &trans
                                     &trans        &trans         &trans        &trans       &kp N0        &kp DOT
            >;
        };

        // NAV: Left Hand = Modifiers | Right Hand = IJKL Arrows
        Nav {
            display-name = "Nav";
            bindings = <
&trans     &trans       &trans       &trans        &trans         &trans        &kp PG_UP    &kp HOME      &kp UP        &kp END      &kp BSPC        &kp DEL
&trans     &kp LCTRL    &kp LALT     &kp LGUI      &kp LSHIFT     &trans        &kp PG_DN    &kp LEFT      &kp DOWN      &kp RIGHT    &trans          &trans
&trans     &kp LG(Z)    &kp LG(X)    &kp LG(C)     &kp LG(V)      &trans        &trans       &trans        &trans        &trans       &trans          &trans
                                     &trans        &trans         &trans        &trans       &trans        &trans
            >;
        };

        // SYM: Optimized for "Drum Roll" typing (Two-Handed Operators)
        // Left: Brackets | Right: Operators
        Symbols {
            display-name = "Symbols";
            bindings = <
&trans     &kp EXCL     &kp AT       &kp HASH      &kp DLLR       &kp PRCNT     &kp CARET    &kp AMPS      &kp STAR      &kp GRAVE    &kp TILDE       &kp BSPC
&trans     &kp LBKT     &kp RBKT     &kp LPAR      &kp RPAR       &kp UNDER     &kp MINUS    &kp EQUAL     &kp PLUS      &kp SEMI     &kp COLON       &kp SQT
&trans     &kp LBRC     &kp RBRC     &kp LT        &kp GT         &kp BSLH      &kp UNDER    &kp FSLH      &kp QMARK     &kp PIPE     &kp DOT         &trans
                                     &trans        &trans         &trans        &trans       &trans        &trans
            >;
        };

        // FN Layer
        Fn {
            display-name = "Fn";
            bindings = <
&trans  &trans  &kp C_RW  &kp C_PP      &kp C_FF      &trans      &kp F12  &kp F7  &kp F8  &kp F9  &trans  &trans
&trans  &trans  &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP  &trans      &kp F11  &kp F4  &kp F5  &kp F6  &trans  &trans
&trans  &trans  &trans    &trans        &trans        &trans      &kp F10  &kp F1  &kp F2  &kp F3  &trans  &trans
                          &trans        &trans        &trans      &trans   &trans  &trans
            >;
        };

        // SYS Layer (Bluetooth / Reset)
        Sys {
            display-name = "Sys";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR      &none         &none    &none    &none  &none  &none
&none         &none         &none         &none         &none         &bootloader     &bootloader   &none    &none    &none  &none  &none
&none         &none         &none         &none         &none         &sys_reset      &sys_reset    &none    &none    &none  &none  &none
                                          &trans        &trans        &trans          &trans        &trans   &trans
            >;
        };

        // MOUSE Layer
        Mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &msc SCRL_UP    &trans          &trans           &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK       &mkp RCLK       &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        
        Sys {
            if-layers = <1 3>;
            then-layer = <5>;
        };
        
        Mouse {
            if-layers = <1 2>;
            then-layer = <6>;
        };
    };
};
